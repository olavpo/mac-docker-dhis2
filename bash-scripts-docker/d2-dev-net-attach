#!/bin/bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Retrofit an existing DHIS2 instance onto the shared `dev-net` bridge so
#   sibling containers (agent sandboxes, MCP servers, etc.) can reach it by
#   hostname. New instances created with d2-instance-create already attach
#   via the compose template; this script is for instances created before
#   the dev-net change, or after `docker compose down` re-created without it.
#
#   Aliases applied on dev-net: `dhis2-<instance>` and `<instance>` for Tomcat,
#   `dhis2-<instance>-db` for Postgres (a side-door for test debugging).
#   Idempotent: containers already on dev-net are left alone.

set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/d2-lib.sh"

if [ "$#" -ne 1 ]; then
  echo "usage: d2-dev-net-attach <instance name>"
  exit 1
fi

INSTANCE=$1

TOMCAT_CONTAINER=$(resolve_tomcat_container "$INSTANCE") || {
  echo "Error: Tomcat container for instance '$INSTANCE' not found."
  echo "       Is the instance created and running?"
  exit 1
}

# Ensure the network exists.
docker network create dev-net >/dev/null 2>&1 || true

on_devnet() {
  docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' \
    "$1" | grep -qw "dev-net"
}

if on_devnet "$TOMCAT_CONTAINER"; then
  echo "✅ $TOMCAT_CONTAINER is already attached to dev-net."
else
  docker network connect \
    --alias "dhis2-$INSTANCE" \
    --alias "$INSTANCE" \
    dev-net "$TOMCAT_CONTAINER"
  echo "✅ $TOMCAT_CONTAINER attached to dev-net."
fi
echo "   Reachable at: http://dhis2-$INSTANCE:8080"

# The database: compose templates from 2026-10 put it on dev-net themselves;
# older instances lose a runtime attachment on every `docker compose down`.
if DB_CONTAINER=$(resolve_db_container "$INSTANCE"); then
  if on_devnet "$DB_CONTAINER"; then
    echo "✅ $DB_CONTAINER is already attached to dev-net."
  else
    docker network connect --alias "dhis2-$INSTANCE-db" dev-net "$DB_CONTAINER"
    echo "✅ $DB_CONTAINER attached to dev-net."
  fi
  echo "   Reachable at: dhis2-$INSTANCE-db:5432"
fi
