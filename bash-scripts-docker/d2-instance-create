#!/bin/bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Script to create DHIS2 instance using plain Tomcat Docker with templates
#   Simplified to use d2-deploy-war and d2-restore-db for WAR and DB operations

set -euo pipefail
IFS=$'\n\t'

# Load common functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/d2-lib.sh"

# Check for required environment variable
if [ -z "${DHIS2_BASE:-}" ]; then
  echo "Error: DHIS2_BASE environment variable not set"
  exit 1
fi

usage() {
  echo "Usage: $0 [options] <instance name>"
  echo "Options:"
  echo "  -v <version>    DHIS2 version to download and deploy"
  echo "  -l <url>        URL to download WAR file from"
  echo "  -s <db_file>    SQL database file to initialize with"
  echo "  -p <port>       HTTP port (default: auto-select 9010-9050)"
  echo "  -g <port>       PostgreSQL port (default: auto-select 5433-5999)"
  echo "  -f <war_file>   Custom WAR file to deploy"
  echo "  -t <version>    Tomcat 9 or 10 (usually omit: auto-selected from -v;"
  echo "                  DHIS2 <=2.41 -> 9, >=2.42 -> 10). Default 10 without -v."
  echo "  -m <size>       Java max heap, e.g. 2g (default: 4g / \$D2_DEFAULT_MEMORY)"
  echo "  -a <backend>    Analytics database backend: doris (requires -v with DHIS2 >= 42)"
  echo "  -z <timezone>   Server time zone for Tomcat and Postgres, e.g. Africa/Lagos"
  echo "                  (default: Etc/UTC)"
  echo "Example: $0 -v 2.42.4 -p 9006 -g 5433 myinstance"
  echo "Example with Doris analytics: $0 -v 42 -a doris myinstance"
  echo "Example with URL: $0 -l https://example.com/custom.war -p 9006 myinstance"
  echo "Example with custom WAR: $0 -f /path/to/custom.war -p 9006 myinstance"
  echo "Example with DB seed: $0 -s /path/to/seed.sql myinstance"
  echo "Example with Tomcat 9: $0 -v 2.41.1 -t 9 myinstance"
  echo "Example without WAR: $0 myinstance (auto-selects ports, no DHIS2)"
  exit 1
}

# Default values
VERSION=""
WAR_URL=""
DB_SEED=""
HTTP_PORT=""
PG_PORT=""
WAR_FILE=""
TOMCAT_VERSION=""  # empty = not specified; resolved below (auto from -v, else 10)
MEMORY=""
ANALYTICS=""
TIMEZONE="Etc/UTC"
DEFAULT_MEMORY="${D2_DEFAULT_MEMORY:-4g}"  # Tomcat max heap when -m omitted

# Parse options
while getopts "v:l:s:p:g:f:t:m:a:z:" opt; do
  case $opt in
    v) VERSION=$OPTARG ;;
    l) WAR_URL=$OPTARG ;;
    s) DB_SEED=$OPTARG ;;
    p) HTTP_PORT=$OPTARG ;;
    g) PG_PORT=$OPTARG ;;
    f) WAR_FILE=$OPTARG ;;
    t) TOMCAT_VERSION=$OPTARG ;;
    m) MEMORY=$OPTARG ;;
    a) ANALYTICS=$OPTARG ;;
    z) TIMEZONE=$OPTARG ;;
    *) usage ;;
  esac
done

shift $((OPTIND-1))

if [ $# -eq 0 ]; then
  usage
fi

# Convert relative paths to absolute paths using helper function
if [ -n "$WAR_FILE" ]; then
  WAR_FILE=$(abspath "$WAR_FILE")
fi

if [ -n "$DB_SEED" ]; then
  DB_SEED=$(abspath "$DB_SEED")
fi

# Validate an explicit -t and reconcile Tomcat with the DHIS2 version. Done
# here — before port selection, directory creation, or docker — so the error
# paths exit with no side effects.
if [ -n "$TOMCAT_VERSION" ] && [ "$TOMCAT_VERSION" != "9" ] && [ "$TOMCAT_VERSION" != "10" ]; then
  echo "Error: -t must be 9 or 10 (got '$TOMCAT_VERSION')" >&2
  exit 1
fi
if [ -n "$VERSION" ]; then
  DHIS_MAJOR=$(dhis2_major "$VERSION")
  REQ_TOMCAT=$(required_tomcat_for_major "$DHIS_MAJOR")
  if [ -z "$TOMCAT_VERSION" ]; then
    TOMCAT_VERSION="$REQ_TOMCAT"
    echo "Auto-selected Tomcat $TOMCAT_VERSION for DHIS2 $VERSION (major $DHIS_MAJOR)"
  elif [ "$TOMCAT_VERSION" != "$REQ_TOMCAT" ]; then
    echo "Error: DHIS2 $VERSION (major $DHIS_MAJOR) requires Tomcat $REQ_TOMCAT," >&2
    echo "       but -t $TOMCAT_VERSION was given. Omit -t to auto-select, or pass -t $REQ_TOMCAT." >&2
    exit 1
  fi
fi
# Fallback when nothing set it (no -v, or -l/-f WAR sources).
TOMCAT_VERSION="${TOMCAT_VERSION:-10}"

# Validate the analytics backend request. Done here — before port
# selection, directory creation, or docker — so error paths have no side
# effects. Doris analytics needs DHIS2 >= 42 (which also implies Tomcat 10).
if [ -n "$ANALYTICS" ]; then
  if [ "$ANALYTICS" != "doris" ]; then
    echo "Error: -a must be 'doris' (got '$ANALYTICS')" >&2
    exit 1
  fi
  if [ -z "$VERSION" ]; then
    echo "Error: -a doris requires -v with a DHIS2 version >= 42" >&2
    exit 1
  fi
  if ! [[ "$DHIS_MAJOR" =~ ^[0-9]+$ ]] || [ "$DHIS_MAJOR" -lt 42 ]; then
    echo "Error: -a doris requires DHIS2 42 or later (got $VERSION, major $DHIS_MAJOR)" >&2
    exit 1
  fi
fi

# Validate the time zone: an IANA name that exists in the host's zoneinfo
# (the containers ship the same database). The character check also keeps
# the value safe for the sed templating below.
if ! [[ "$TIMEZONE" =~ ^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$ ]] \
   || [ ! -f "/usr/share/zoneinfo/$TIMEZONE" ]; then
  echo "Error: -z must be an IANA time zone such as Africa/Lagos (got '$TIMEZONE')" >&2
  exit 1
fi

# Resolve and validate the Tomcat max heap (default 4g; see D2_DEFAULT_MEMORY)
MEMORY="${MEMORY:-$DEFAULT_MEMORY}"
if ! echo "$MEMORY" | grep -qE '^[0-9]+[mMgG]$'; then
  echo "Error: -m memory must match ^[0-9]+[mMgG]\$ (e.g. 512m, 2g)"
  exit 1
fi
JAVA_MEM_OPTS=" -Xmx${MEMORY}"

INSTANCE=$1
# Same rule the broker enforces (NAME_RE in d2-broker): sane compose project
# names, no path tricks (spaces, slashes) that would break the sed templating
# below, and no collision with the reserved _-prefixed dirs (_seeds, _broker).
if ! [[ "$INSTANCE" =~ ^[a-z][a-z0-9_-]{1,29}$ ]]; then
  echo "Error: instance name must match ^[a-z][a-z0-9_-]{1,29}\$ (got '$INSTANCE')" >&2
  exit 1
fi
DHIS2_HOME="$DHIS2_BASE/$INSTANCE"



# HTTP port: auto-select a non-colliding one, or validate an explicit -p.
if [ -z "$HTTP_PORT" ]; then
  echo "Auto-selecting HTTP port..."
  for port in $(seq 9010 9050); do
    if port_available "$port"; then
      HTTP_PORT=$port
      echo "Selected HTTP port: $HTTP_PORT"
      break
    fi
  done
  if [ -z "$HTTP_PORT" ]; then
    echo "Error: No available HTTP ports found in range 9010-9050"
    exit 1
  fi
elif ! port_available "$HTTP_PORT"; then
  echo "Error: HTTP port $HTTP_PORT is already in use or reserved by another instance" >&2
  exit 1
fi

# PostgreSQL port: auto-select a non-colliding one, or validate an explicit -g.
if [ -z "$PG_PORT" ]; then
  echo "Auto-selecting PostgreSQL port..."
  for port in $(seq 5433 5999); do
    if port_available "$port"; then
      PG_PORT=$port
      echo "Selected PostgreSQL port: $PG_PORT"
      break
    fi
  done
  if [ -z "$PG_PORT" ]; then
    echo "Error: No available PostgreSQL ports found in range 5433-5999"
    exit 1
  fi
elif ! port_available "$PG_PORT"; then
  echo "Error: PostgreSQL port $PG_PORT is already in use or reserved by another instance" >&2
  exit 1
fi

# Check if instance already exists
if [ -d "$DHIS2_HOME" ]; then
  echo "Error: Instance directory $DHIS2_HOME already exists"
  echo "       Use d2-instance-delete or choose a different name."
  exit 1
fi

# Create DHIS2 directory structure on host
mkdir -p "$DHIS2_HOME"
mkdir -p "$DHIS2_HOME/DHIS2_HOME"
mkdir -p "$DHIS2_HOME/webapps"
mkdir -p "$DHIS2_HOME/logs"
mkdir -p "$DHIS2_HOME/temp"
mkdir -p "$DHIS2_HOME/lib"
mkdir -p "$DHIS2_HOME/backups"

# Determine Tomcat version for display
if [ "$TOMCAT_VERSION" = "9" ]; then
  TOMCAT_DISPLAY="9 (JDK 17)"
else
  TOMCAT_DISPLAY="10 (JDK 17)"
fi

echo "Creating DHIS2 instance with Tomcat: $INSTANCE"
echo "  DHIS2 Version: ${VERSION:-None}"
echo "  Tomcat Version: $TOMCAT_DISPLAY"
echo "  HTTP Port: $HTTP_PORT"
echo "  PostgreSQL Port: $PG_PORT"
echo "  Tomcat heap:     -Xmx$MEMORY"
[ -n "$ANALYTICS" ] && echo "  Analytics DB:    $ANALYTICS"
echo "  Time zone:       $TIMEZONE"

# Copy template files
cp "${DHIS2_BASE}/_templates/dhis.conf" "$DHIS2_HOME/DHIS2_HOME/dhis.conf"
cp "${DHIS2_BASE}/_templates/log4j2.xml" "$DHIS2_HOME/DHIS2_HOME/log4j2.xml"
sed "s/\${INSTANCE_NAME}/$INSTANCE/g" "${DHIS2_BASE}/_templates/server.xml" > "$DHIS2_HOME/server.xml"

# Doris backend: copy conf assets, ensure the Postgres JDBC jar (cached in
# _templates/doris/, downloaded from Maven Central on first use), activate
# the compose profile via .env, and point DHIS2 at Doris in dhis.conf.
if [ "$ANALYTICS" = "doris" ]; then
  if [ ! -f "${DHIS2_BASE}/_templates/doris/fe.conf" ]; then
    echo "Error: ${DHIS2_BASE}/_templates/doris/ is missing — run setup.sh update" >&2
    rm -rf "$DHIS2_HOME"
    exit 1
  fi
  PGJDBC_VERSION="42.7.5"
  PGJDBC_JAR="postgresql-${PGJDBC_VERSION}.jar"
  PGJDBC_CACHE="${DHIS2_BASE}/_templates/doris/${PGJDBC_JAR}"
  if [ ! -f "$PGJDBC_CACHE" ]; then
    echo "Downloading Postgres JDBC driver ${PGJDBC_VERSION} (for the Doris catalog)..."
    PGJDBC_URL="https://repo1.maven.org/maven2/org/postgresql/postgresql/${PGJDBC_VERSION}/${PGJDBC_JAR}"
    curl -fSL --no-progress-meter -o "${PGJDBC_CACHE}.tmp" "$PGJDBC_URL"
    EXPECTED_SHA=$(curl -fsSL "${PGJDBC_URL}.sha256")
    ACTUAL_SHA=$(shasum -a 256 "${PGJDBC_CACHE}.tmp" | cut -d' ' -f1)
    if [ "$EXPECTED_SHA" != "$ACTUAL_SHA" ]; then
      echo "Error: JDBC driver checksum mismatch (expected $EXPECTED_SHA, got $ACTUAL_SHA)" >&2
      rm -f "${PGJDBC_CACHE}.tmp"
      rm -rf "$DHIS2_HOME"
      exit 1
    fi
    mv "${PGJDBC_CACHE}.tmp" "$PGJDBC_CACHE"
  fi
  mkdir -p "$DHIS2_HOME/doris"
  cp "${DHIS2_BASE}/_templates/doris/fe.conf" "$DHIS2_HOME/doris/fe.conf"
  cp "${DHIS2_BASE}/_templates/doris/be.conf" "$DHIS2_HOME/doris/be.conf"
  cp "$PGJDBC_CACHE" "$DHIS2_HOME/doris/${PGJDBC_JAR}"
  # Activates the doris service for every compose invocation in this
  # directory (startup, shutdown, delete, set-memory) with no flag changes.
  echo "COMPOSE_PROFILES=analytics-doris" > "$DHIS2_HOME/.env"
  cat >> "$DHIS2_HOME/DHIS2_HOME/dhis.conf" << 'DORISCONF'

# Apache Doris analytics database (added by d2-instance-create -a doris)
analytics.database = doris
analytics.connection.url = jdbc:mysql://doris:9030/analytics?useUnicode=true&characterEncoding=UTF-8&useSSL=false
analytics.connection.username = root
analytics.connection.password =
DORISCONF
fi

# Select appropriate template based on Tomcat version
if [ "$TOMCAT_VERSION" = "9" ]; then
  TEMPLATE_FILE="${DHIS2_BASE}/_templates/docker-compose-tomcat9.yml"
else
  TEMPLATE_FILE="${DHIS2_BASE}/_templates/docker-compose-tomcat10.yml"
fi

# Create docker-compose.yml from selected template
sed "s/\${PG_PORT:-5432}/$PG_PORT/g; \
     s/\${HTTP_PORT:-8080}/$HTTP_PORT/g; \
     s/\${JAVA_MEM_OPTS}/$JAVA_MEM_OPTS/g; \
     s/\${INSTANCE_NAME}/$INSTANCE/g; \
     s|\${TIMEZONE}|$TIMEZONE|g" \
  "$TEMPLATE_FILE" > "$DHIS2_HOME/docker-compose.yml"

# Ensure the shared dev-net network exists (used to expose this instance to
# agent sandboxes and other containers by hostname). Safe to run repeatedly.
docker network create dev-net >/dev/null 2>&1 || true

# Start the instance
cd "$DHIS2_HOME"
docker compose up -d

# Wait for database to be ready
echo "Waiting for database to be ready..."
DB_CONTAINER=$(resolve_db_container "$INSTANCE") || {
  echo "Error: Database container not found after startup"
  exit 1
}
if ! wait_for_db "$DB_CONTAINER"; then
  echo "Error: Database did not become ready in time"
  exit 1
fi

# Doris: create the analytics database (DHIS2 only creates its catalog)
# and set laptop-sized spill globals. compose up already waited for the
# Doris healthcheck (BE alive) via the tomcat depends_on, so this can run
# immediately. Must happen before the WAR boots, or DHIS2's analytics
# runs would fail against a missing database.
if [ "$ANALYTICS" = "doris" ]; then
  echo "Initializing Doris analytics database..."
  if ! doris_init "$INSTANCE"; then
    echo "Error: Doris initialization failed" >&2
    exit 1
  fi
fi

# Deploy WAR file and/or restore database if specified
if [ -n "$WAR_FILE" ] || [ -n "$WAR_URL" ] || [ -n "$VERSION" ] || [ -n "$DB_SEED" ]; then
  echo "Deploying WAR file and/or restoring database..."
  
  # Restore database FIRST if specified (so database is ready when WAR starts)
  if [ -n "$DB_SEED" ]; then
    echo "Restoring database..."
    "$SCRIPT_DIR/d2-db-restore" "$INSTANCE" "$DB_SEED"
  fi
  
  # Deploy WAR file if specified (after database is restored)
  if [ -n "$WAR_FILE" ] || [ -n "$WAR_URL" ] || [ -n "$VERSION" ]; then
    echo "Deploying WAR file..."
    if [ -n "$WAR_FILE" ]; then
      "$SCRIPT_DIR/d2-deploy-war" -f "$WAR_FILE" "$INSTANCE"
    elif [ -n "$WAR_URL" ]; then
      "$SCRIPT_DIR/d2-deploy-war" -l "$WAR_URL" "$INSTANCE"
    elif [ -n "$VERSION" ]; then
      "$SCRIPT_DIR/d2-deploy-war" -v "$VERSION" "$INSTANCE"
    fi
  fi
  
  echo "✅ Deployment completed"
fi

# Empty instance (version, no seed): once DHIS2 has initialized its schema,
# ensure the known local_admin superuser. Best-effort — never fails the create.
# (Seeded creates get local_admin via d2-db-restore instead, with Tomcat
# stopped.) Here Tomcat is running and local_admin may already have been
# looked up and failed — the broker's readiness probe authenticates as
# local_admin — so DHIS2 can keep answering 401 for a minute or two after the
# INSERT. Clear the cache and confirm the login before finishing.
if [ -n "$VERSION" ] && [ -z "$DB_SEED" ]; then
  echo "Waiting for DHIS2 to initialize before adding local_admin..."
  la_done=0
  for _ in $(seq 1 60); do
    code=$(curl -s -u admin:district -o /dev/null -w '%{http_code}' \
           "http://localhost:$HTTP_PORT/api/system/info" || true)
    if [ "$code" = "200" ]; then
      if "$SCRIPT_DIR/d2-local-admin" "$INSTANCE" add; then
        curl -s -u admin:district -o /dev/null -X POST \
          "http://localhost:$HTTP_PORT/api/maintenance/cacheClear" || true
        la_ok=0
        for _ in $(seq 1 24); do
          code=$(curl -s -u local_admin:district -o /dev/null -w '%{http_code}' \
                 "http://localhost:$HTTP_PORT/api/me" || true)
          if [ "$code" = "200" ]; then la_ok=1; break; fi
          sleep 5
        done
        if [ "$la_ok" = 1 ]; then
          echo "✅ local_admin ensured and logging in"
        else
          echo "⚠️  local_admin added but /api/me still answers $code after 2 min (admin/district still works)"
        fi
      else
        echo "⚠️  could not add local_admin (admin/district still works)"
      fi
      la_done=1
      break
    fi
    sleep 10
  done
  [ "$la_done" = 1 ] || echo "⚠️  DHIS2 did not answer in time; local_admin not added (admin/district still works)"
fi

# Final output
echo ""
echo "✅ DHIS2 instance $INSTANCE created successfully with Tomcat $TOMCAT_DISPLAY"
echo "  Access:       http://localhost:$HTTP_PORT"
echo "  dev-net:      http://dhis2-$INSTANCE:8080 (reachable from containers on dev-net)"
echo "  PostgreSQL:   localhost:$PG_PORT (user: dhis, password: dhis, db: dhis2)"
if [ "$ANALYTICS" = "doris" ]; then
  echo "  Doris:        doris:9030 inside the instance network (MySQL protocol, root, empty password)"
  echo "                dev-net: dhis2-$INSTANCE-doris:9030"
fi
echo "  DHIS2_HOME:   $DHIS2_HOME/DHIS2_HOME/"


