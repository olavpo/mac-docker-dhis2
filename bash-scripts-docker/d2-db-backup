#!/bin/bash
# Simple script to create database backup in common [Backups] directory

set -euo pipefail
IFS=$'\n\t'

# Load common functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/d2-lib.sh"

# Check for required environment variable
if [ -z "${DHIS2_BASE:-}" ]; then
  echo "Error: DHIS2_BASE environment variable not set"
  exit 1
fi

usage() {
  echo "Usage: $0 [-l <label>] <instance name>"
  echo "Creates a timestamped database backup in the common [Backups] directory"
  echo "  -l <label>   optional tag folded into the backup filename"
  exit 1
}

LABEL=""
while getopts "l:" opt; do
  case $opt in
    l) LABEL=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND-1))

if [ $# -eq 0 ]; then
  usage
fi

INSTANCE=$1
DHIS2_HOME="$DHIS2_BASE/$INSTANCE"
BACKUP_DIR="$DHIS2_BASE/_backups/$INSTANCE"

# Check if instance exists
if [ ! -d "$DHIS2_HOME" ]; then
  echo "Error: Instance $INSTANCE does not exist"
  exit 1
fi

# Create [Backups] directory if it doesn't exist
mkdir -p "$BACKUP_DIR"

# Find database container
DB_CONTAINER=$(resolve_db_container "$INSTANCE") || {
  echo "Error: Database container for instance $INSTANCE not found"
  exit 1
}

# resolve_db_container also matches stopped containers; pg_dump needs a
# running one, and failing mid-pipeline would leave an empty backup file.
DB_STATUS=$(docker inspect -f '{{.State.Status}}' "$DB_CONTAINER" 2>/dev/null || echo "missing")
if [ "$DB_STATUS" != "running" ]; then
  echo "Error: Database container $DB_CONTAINER is not running ($DB_STATUS)"
  echo "       Start the instance first: d2-startup $INSTANCE"
  exit 1
fi

# Query database for version to include in filename
MAJOR_VERSION=$(get_db_major_version "$DB_CONTAINER") || true

# Create backup with timestamp, version, and optional label
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
SUFFIX=""
if [ -n "$LABEL" ]; then
  SUFFIX="_${LABEL}"
fi
if [ -n "$MAJOR_VERSION" ]; then
  BACKUP_FILE="$BACKUP_DIR/${INSTANCE}_${TIMESTAMP}_v${MAJOR_VERSION}${SUFFIX}.sql.gz"
else
  BACKUP_FILE="$BACKUP_DIR/${INSTANCE}_${TIMESTAMP}${SUFFIX}.sql.gz"
fi

echo "Creating backup of $INSTANCE database..."
echo "Backup will be saved to: $BACKUP_FILE"

# Strip the known-password local_admin superuser from the dump so it never
# lands in a backup; always re-add it afterward (even if the dump fails).
"$SCRIPT_DIR/d2-local-admin" "$INSTANCE" remove \
  || echo "⚠️  Warning: could not remove local_admin; dump may contain it"
trap '"$SCRIPT_DIR/d2-local-admin" "$INSTANCE" add >/dev/null 2>&1 || true' EXIT

# Dump database and compress
docker exec "$DB_CONTAINER" pg_dump -U dhis -d dhis2 | gzip > "$BACKUP_FILE"

echo "✅ Backup created: $BACKUP_FILE"
echo ""
echo "💡 Backup location: $BACKUP_DIR/"
echo "   Latest backup: $(basename "$BACKUP_FILE")"
echo "   To restore: $SCRIPT_DIR/d2-db-restore $INSTANCE $BACKUP_FILE"
