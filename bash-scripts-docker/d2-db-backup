#!/bin/bash
# Simple script to create database backup in common [Backups] directory

set -euo pipefail
IFS=$'\n\t'

# Load common functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/d2-lib.sh"

# Check for required environment variable
if [ -z "${DHIS2_BASE:-}" ]; then
  echo "Error: DHIS2_BASE environment variable not set"
  exit 1
fi

usage() {
  echo "Usage: $0 [-l <label>] <instance name>"
  echo "Creates a timestamped database backup in the common [Backups] directory"
  echo "Analytics tables are excluded; DHIS2 rebuilds them when analytics runs"
  echo "  -l <label>   optional tag folded into the backup filename"
  exit 1
}

LABEL=""
while getopts "l:" opt; do
  case $opt in
    l) LABEL=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND-1))

if [ $# -eq 0 ]; then
  usage
fi

INSTANCE=$1
DHIS2_HOME="$DHIS2_BASE/$INSTANCE"
BACKUP_DIR="$DHIS2_BASE/_backups/$INSTANCE"

# Check if instance exists
if [ ! -d "$DHIS2_HOME" ]; then
  echo "Error: Instance $INSTANCE does not exist"
  exit 1
fi

# Create [Backups] directory if it doesn't exist
mkdir -p "$BACKUP_DIR"

# Find database container
DB_CONTAINER=$(resolve_db_container "$INSTANCE") || {
  echo "Error: Database container for instance $INSTANCE not found"
  exit 1
}

# resolve_db_container also matches stopped containers; pg_dump needs a
# running one, and failing mid-pipeline would leave an empty backup file.
DB_STATUS=$(docker inspect -f '{{.State.Status}}' "$DB_CONTAINER" 2>/dev/null || echo "missing")
if [ "$DB_STATUS" != "running" ]; then
  echo "Error: Database container $DB_CONTAINER is not running ($DB_STATUS)"
  echo "       Start the instance first: d2-startup $INSTANCE"
  exit 1
fi

# Query database for version to include in filename
MAJOR_VERSION=$(get_db_major_version "$DB_CONTAINER") || true

# Create backup with timestamp, version, and optional label
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
SUFFIX=""
if [ -n "$LABEL" ]; then
  SUFFIX="_${LABEL}"
fi
if [ -n "$MAJOR_VERSION" ]; then
  BACKUP_FILE="$BACKUP_DIR/${INSTANCE}_${TIMESTAMP}_v${MAJOR_VERSION}${SUFFIX}.sql.gz"
else
  BACKUP_FILE="$BACKUP_DIR/${INSTANCE}_${TIMESTAMP}${SUFFIX}.sql.gz"
fi

echo "Creating backup of $INSTANCE database..."
echo "Backup will be saved to: $BACKUP_FILE"

# Strip the known-password local_admin superuser from the dump so it never
# lands in a backup; always re-add it afterward (even if the dump fails). The
# remove reassigns any objects local_admin created to admin, and the re-add
# mints a fresh row — harmless for these test instances.
"$SCRIPT_DIR/d2-local-admin" "$INSTANCE" remove \
  || echo "⚠️  Warning: could not remove local_admin; dump may contain it"
trap '"$SCRIPT_DIR/d2-local-admin" "$INSTANCE" add >/dev/null 2>&1 || true' EXIT

# Analytics tables hold derived data only, and they usually dominate the dump
# size. DHIS2 drops and recreates them on the next analytics run, so they are
# never backed up. The two patterns cover the partitioned "analytics" tables
# and the analytics_* family (event/enrollment/ownership partitions, the
# analytics_rs_* resource tables from 2.41 on, and any analytics_temp_*
# leftovers). They are anchored rather than a bare "analytics*" glob, so a
# metadata table whose name merely starts with "analytics" stays in the dump.
PG_DUMP_EXCLUDES=(-T 'analytics' -T 'analytics_*')

# SQL views that read an analytics table are still dumped, but their CREATE
# VIEW fails on restore until analytics is rebuilt (psql logs the error and
# carries on, so the restore still succeeds without them). Warn so the gap is
# visible at backup time. Best-effort: never block the dump.
warn_views_on_analytics() {
  local views
  views=$(docker exec "$DB_CONTAINER" psql -U dhis -d dhis2 -tA -c "
    SELECT DISTINCT v.relname
    FROM pg_depend d
    JOIN pg_rewrite r ON r.oid = d.objid
    JOIN pg_class v ON v.oid = r.ev_class
    JOIN pg_class t ON t.oid = d.refobjid
    JOIN pg_namespace n ON n.oid = t.relnamespace
    WHERE d.classid = 'pg_rewrite'::regclass
      AND v.relkind IN ('v', 'm')
      AND n.nspname = 'public'
      AND (t.relname = 'analytics' OR t.relname LIKE 'analytics\\_%')
      AND v.relname NOT LIKE 'analytics%'
    ORDER BY 1;") || return 0
  [ -n "$views" ] || return 0
  echo "⚠️  Warning: these views read excluded analytics tables. They will not"
  echo "   restore until analytics is rebuilt on the target instance:"
  echo "$views" | sed 's/^/     /'
}
warn_views_on_analytics

# Dump database and compress
docker exec "$DB_CONTAINER" pg_dump -U dhis -d dhis2 "${PG_DUMP_EXCLUDES[@]}" | gzip > "$BACKUP_FILE"

echo "✅ Backup created: $BACKUP_FILE"
echo ""
echo "💡 Backup location: $BACKUP_DIR/"
echo "   Latest backup: $(basename "$BACKUP_FILE")"
echo "   To restore: $SCRIPT_DIR/d2-db-restore $INSTANCE $BACKUP_FILE"
