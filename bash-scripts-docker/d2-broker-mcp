#
#   d2-broker-mcp — MCP stdio server over the d2-broker HTTP API, so a
#   local MCP client (Claude Desktop, Claude Code) can spin up disposable
#   DHIS2 instances to test and validate things.
#
#   Deliberately agent-scoped: it authenticates with the broker's "agent"
#   token, confining the client to agent-* instances, the instance cap,
#   and curated seeds. It never reads the admin token. The broker stays
#   loopback-bound and unchanged — this is just a protocol adapter.
#
#   The MCP client spawns this process and speaks newline-delimited
#   JSON-RPC 2.0 on stdin/stdout (the MCP stdio transport). stdout is
#   protocol-only; diagnostics go to stderr. No dependencies beyond the
#   Python 3 standard library. See docs/broker-mcp.md for client setup.
#
#   Configuration (env vars):
#     DHIS2_BROKER_URL    Broker base URL (default http://localhost:9300).
#     DHIS2_BROKER_TOKEN  Bearer token. If unset, the agent token is read
#                         from $DHIS2_BASE/_broker/tokens.json.
#     DHIS2_BASE          Instance base dir (default ~/dhis2). GUI-spawned
#                         processes don't inherit shell env, hence the
#                         default.

import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

PROTOCOL_VERSION = "2025-06-18"
SERVER_INFO = {"name": "d2-broker-mcp", "version": "1.0.0"}
HTTP_TIMEOUT = 15       # broker answers fast; long work is a job
POLL_INTERVAL = 2.0     # wait_for_job re-fetch cadence
WAIT_DEFAULT = 60
WAIT_MAX = 240
TERMINAL_STATUSES = {"succeeded", "failed", "interrupted"}


# ---------------------------------------------------------------- config

def broker_url():
    return os.environ.get("DHIS2_BROKER_URL",
                          "http://localhost:9300").rstrip("/")


class ConfigError(Exception):
    pass


def resolve_token():
    token = os.environ.get("DHIS2_BROKER_TOKEN")
    if token:
        return token
    base = os.environ.get("DHIS2_BASE") or str(Path.home() / "dhis2")
    path = Path(base) / "_broker" / "tokens.json"
    try:
        with open(path) as f:
            return json.load(f)["agent"]["token"]
    except (OSError, KeyError, ValueError):
        raise ConfigError(
            f"no broker token: set DHIS2_BROKER_TOKEN, or make sure the "
            f"agent token is readable at {path} (create it with "
            f"'d2-broker tokens')")


# ------------------------------------------------------------ broker HTTP

class BrokerUnreachable(Exception):
    pass


def broker_request(method, path, body=None):
    """Call the broker; return (status, parsed-JSON-body)."""
    url = broker_url() + path
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(
        url, data=data, method=method,
        headers={"Authorization": f"Bearer {resolve_token()}",
                 "Content-Type": "application/json",
                 # Lets the broker log say which MCP process (and so which
                 # client session) made a destructive call.
                 "User-Agent": f"d2-broker-mcp pid={os.getpid()} "
                               f"ppid={os.getppid()}"})
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as resp:
            return resp.status, json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            payload = json.loads(raw)
        except ValueError:
            payload = {"error": raw.decode(errors="replace") or e.reason}
        return e.code, payload
    except (urllib.error.URLError, TimeoutError) as e:
        reason = getattr(e, "reason", e)
        raise BrokerUnreachable(
            f"broker not reachable at {broker_url()} ({reason}) — is it "
            f"running? Check with 'd2-broker status'.")


# ----------------------------------------------------------------- tools

def _pretty(payload):
    return json.dumps(payload, indent=2)


def tool_list_instances(args):
    return broker_request("GET", "/instances?full=1")


def tool_create_instance(args):
    body = {k: args[k] for k in
            ("name", "version", "seed", "memory", "label", "timezone")
            if k in args}
    return broker_request("POST", "/instances", body)


def tool_reset_instance(args):
    return broker_request("POST", f"/instances/{args['name']}/reset",
                          {"seed": args["seed"]})


def tool_start_instance(args):
    return broker_request("POST", f"/instances/{args['name']}/start", {})


def tool_stop_instance(args):
    return broker_request("POST", f"/instances/{args['name']}/stop", {})


def tool_delete_instance(args):
    return broker_request("DELETE", f"/instances/{args['name']}")


def tool_run_analytics(args):
    body = {"last_years": args["last_years"]} if "last_years" in args else {}
    return broker_request("POST", f"/instances/{args['name']}/analytics",
                          body)


def tool_list_seeds(args):
    return broker_request("GET", "/seeds")


def tool_get_job(args):
    return broker_request("GET", f"/jobs/{args['job_id']}")


def tool_wait_for_job(args):
    timeout = min(max(args.get("timeout_seconds", WAIT_DEFAULT), 0), WAIT_MAX)
    deadline = time.monotonic() + timeout
    while True:
        status, job = broker_request("GET", f"/jobs/{args['job_id']}")
        if status >= 400 or job.get("status") in TERMINAL_STATUSES:
            return status, job
        if time.monotonic() >= deadline:
            return status, job  # still running; caller can wait again
        time.sleep(POLL_INTERVAL)


