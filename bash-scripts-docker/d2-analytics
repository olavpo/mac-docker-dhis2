#!/usr/bin/env python3
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___/____/____/
#
#   Run DHIS2 analytics table generation on an instance and wait for it to
#   finish, printing progress. Exits 0 when DHIS2 reports the run completed
#   without error, non-zero otherwise — so the broker can run it as a job.
#
#   Usage: d2-analytics <instance name> [last_years]
#
#   Authenticates as the broker's local_admin superuser on the instance's
#   host-published port. Things this handles that hand-rolled loops got
#   wrong (see the dhis2-instances skill):
#   - the task list is [] before the first notification arrives, and also
#     after a Tomcat restart erased it; only the second is a failure;
#   - a stale RUNNING analytics job left by a restart makes the new run wait
#     forever; this reports it instead of hanging.

import base64
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

AUTH = "Basic " + base64.b64encode(b"local_admin:district").decode()
POLL = 15
START_GRACE = 600      # seconds to wait for the first notification
OUTAGE_GRACE = 600     # seconds of connection errors tolerated mid-run
CAP = int(os.environ.get("D2_ANALYTICS_CAP", 6900))  # under the broker's 7200


def http_port(instance):
    for name in (f"{instance}-tomcat-1", f"{instance}_tomcat_1"):
        out = subprocess.run(["docker", "port", name, "8080/tcp"],
                             capture_output=True, text=True).stdout
        for line in out.splitlines():
            m = re.search(r":(\d+)$", line.strip())
            if m:
                return int(m.group(1))
    return None


def call(base, path, method="GET"):
    req = urllib.request.Request(base + path, method=method, headers={
        "Accept": "application/json", "Authorization": AUTH})
    with urllib.request.urlopen(req, timeout=30) as r:
        raw = r.read().decode() or "null"
    return json.loads(raw)


def main():
    if len(sys.argv) not in (2, 3):
        sys.exit("Usage: d2-analytics <instance name> [last_years]")
    instance = sys.argv[1]
    query = ""
    if len(sys.argv) == 3:
        if not sys.argv[2].isdigit() or not 1 <= int(sys.argv[2]) <= 50:
            sys.exit("Error: last_years must be an integer 1-50")
        query = f"?lastYears={sys.argv[2]}"

    port = http_port(instance)
    if not port:
        sys.exit(f"Error: no running Tomcat with a published port for "
                 f"{instance}")
    base = f"http://localhost:{port}"

    resp = call(base, f"/api/resourceTables/analytics{query}", "POST")
    body = resp.get("response", resp) if isinstance(resp, dict) else {}
    job_id = body.get("id")
    endpoint = body.get("relativeNotifierEndpoint") or (
        f"/api/system/tasks/ANALYTICS_TABLE/{job_id}" if job_id else None)
    if not endpoint:
        sys.exit(f"Error: unexpected response from DHIS2: {resp}")
    print(f"Started analytics job {job_id}{' (' + query[1:] + ')' if query else ''}",
          flush=True)

    started = time.monotonic()
    seen = set()
    seen_any = False
    last_ok = time.monotonic()
    while True:
        if time.monotonic() - started > CAP:
            sys.exit(f"Error: analytics still running after {CAP}s; "
                     f"stopped waiting (the run itself may continue)")
        time.sleep(POLL)
        try:
            notes = call(base, endpoint) or []
        except (urllib.error.URLError, OSError, ValueError) as e:
            if time.monotonic() - last_ok > OUTAGE_GRACE:
                sys.exit(f"Error: instance unreachable for {OUTAGE_GRACE}s "
                         f"({e}); Tomcat probably died")
            continue
        last_ok = time.monotonic()

        if not notes:
            if seen_any:
                sys.exit("Error: the job's notifications vanished — Tomcat "
                         "restarted mid-run and the run is lost. Its "
                         "jobConfigurations row may stay RUNNING and block "
                         "the next run; DELETE /api/jobConfigurations/"
                         f"{job_id} clears it.")
            if time.monotonic() - started > START_GRACE:
                sys.exit(f"Error: no progress after {START_GRACE}s. A stale "
                         "ANALYTICS_TABLE job left RUNNING by an earlier "
                         "Tomcat restart blocks new runs: find it in "
                         "/api/jobConfigurations?filter=jobType:eq:"
                         "ANALYTICS_TABLE&fields=id,jobStatus and DELETE it.")
            continue

        seen_any = True
        # Newest first from DHIS2; print the new ones oldest first.
        for n in reversed(notes):
            key = (n.get("time"), n.get("message"))
            if key in seen:
                continue
            seen.add(key)
            print(f"{n.get('time', '')}  {n.get('level', '')}  "
                  f"{n.get('message', '')}", flush=True)
        done = [n for n in notes if n.get("completed")]
        if done:
            if any(n.get("level") == "ERROR" for n in done):
                sys.exit("❌ Analytics finished with an error (see above)")
            print("✅ Analytics tables updated", flush=True)
            return


if __name__ == "__main__":
    main()
